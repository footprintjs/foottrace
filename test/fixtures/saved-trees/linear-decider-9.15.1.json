{
  "name": "linear-decider",
  "description": "3 linear stages into a decider (decide() filter+fn rules, default branch). Exercises: typed writes, deep write, $metric timing path, decision evidence, branch routing.",
  "structureEvents": [
    {
      "method": "onStageAdded",
      "event": {
        "stageId": "intake",
        "name": "Intake",
        "type": "stage",
        "spec": {
          "name": "Intake",
          "id": "intake",
          "type": "stage",
          "description": "Receive the loan application"
        }
      }
    },
    {
      "method": "onStageAdded",
      "event": {
        "stageId": "enrich",
        "name": "Enrich",
        "type": "stage",
        "spec": {
          "name": "Enrich",
          "id": "enrich",
          "type": "stage",
          "description": "Attach applicant profile"
        }
      }
    },
    {
      "method": "onEdgeAdded",
      "event": {
        "from": "intake",
        "to": "enrich",
        "kind": "next"
      }
    },
    {
      "method": "onStageAdded",
      "event": {
        "stageId": "classify-risk",
        "name": "ClassifyRisk",
        "type": "stage",
        "spec": {
          "name": "ClassifyRisk",
          "id": "classify-risk",
          "type": "stage",
          "hasDecider": true,
          "description": "Route by computed risk tier"
        }
      }
    },
    {
      "method": "onEdgeAdded",
      "event": {
        "from": "enrich",
        "to": "classify-risk",
        "kind": "next"
      }
    },
    {
      "method": "onStageAdded",
      "event": {
        "stageId": "approve",
        "name": "Approve",
        "type": "stage",
        "spec": {
          "name": "Approve",
          "id": "approve",
          "type": "stage",
          "description": "Issue approval"
        }
      }
    },
    {
      "method": "onEdgeAdded",
      "event": {
        "from": "classify-risk",
        "to": "approve",
        "kind": "decision-branch",
        "label": "approve"
      }
    },
    {
      "method": "onStageAdded",
      "event": {
        "stageId": "review",
        "name": "ManualReview",
        "type": "stage",
        "spec": {
          "name": "ManualReview",
          "id": "review",
          "type": "stage",
          "description": "Queue for manual review"
        }
      }
    },
    {
      "method": "onEdgeAdded",
      "event": {
        "from": "classify-risk",
        "to": "review",
        "kind": "decision-branch",
        "label": "review"
      }
    },
    {
      "method": "onStageAdded",
      "event": {
        "stageId": "reject",
        "name": "Reject",
        "type": "stage",
        "spec": {
          "name": "Reject",
          "id": "reject",
          "type": "stage",
          "description": "Issue rejection"
        }
      }
    },
    {
      "method": "onEdgeAdded",
      "event": {
        "from": "classify-risk",
        "to": "reject",
        "kind": "decision-branch",
        "label": "reject"
      }
    },
    {
      "method": "onDeciderComplete",
      "event": {
        "decider": "classify-risk",
        "type": "decider",
        "branchIds": [
          "approve",
          "review",
          "reject"
        ],
        "defaultBranch": "reject"
      }
    }
  ],
  "runtimeEvents": [

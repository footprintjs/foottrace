{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "foottrace": [
        "../src/index.ts"
      ],
      "foottrace/write": [
        "../src/write.ts"
      ],
      "foottrace/paths": [
        "../src/paths.ts"
      ],
      "foottrace/cause": [
        "../src/cause.ts"
      ],
      "foottrace/prov": [
        "../src/prov.ts"
      ]
    }
  },
  "include": [
    "**/*.ts"
  ]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "foottrace": ["../src/index.ts"],
      "foottrace/write": ["../src/write.ts"],
      "foottrace/paths": ["../src/paths.ts"]
    }
  },
  "include": ["**/*.ts"]
}
